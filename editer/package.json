{
  "name": "ydlab-editer",
  "version": "1.0.0",
  "private": true,
  "description": "曜動科技 — 在庫器材 / 案例 JSON 編輯器",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"vite --host 127.0.0.1 --port 5173\" \"node scripts/wait-and-electron.cjs\"",
    "electron": "node scripts/wait-and-electron.cjs --no-wait",
    "build": "vite build",
    "start": "npm run build && env -u ELECTRON_RUN_AS_NODE electron ."
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^8.2.2",
    "electron": "^28.3.3",
    "vite": "^4.5.5"
  }
}
